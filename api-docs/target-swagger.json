      "/api/logout": {
        "post": {
          "summary": "User logout",
          "description": "Invalidates the current user session and JWT token.\nAfter logout, the token will no longer be valid for authenticated requests.",
          "tags": ["Authentication"],
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "responses": {
            "200": {
              "description": "Logout successful",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string",
                        "example": "Logout successful"
                      },
                      "requestId": {
                        "type": "string",
                        "format": "ulid"
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "description": "Authentication required",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "error": {
                        "type": "string",
                        "example": "Authentication required"
                      },
                      "requestId": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            "500": {
              "description": "Internal server error"
            }
          }
        }
      },
      "/api/token/claims": {
        "get": {
          "summary": "Inspect current JWT token claims",
          "description": "Returns the authenticated user's JWT claims as parsed and validated by the SDK middleware.\nUseful for debugging authentication issues and understanding token contents.",
          "tags": ["Authentication", "Debug"],
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "responses": {
            "200": {
              "description": "Current user claims from JWT token",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "requestId": {
                        "type": "string",
                        "format": "ulid"
                      },
                      "user": {
                        "type": "object",
                        "description": "Decoded JWT claims",
                        "properties": {
                          "sub": {
                            "type": "string",
                            "description": "Subject (user ID)"
                          },
                          "aud": {
                            "type": "string",
                            "description": "Audience"
                          },
                          "iss": {
                            "type": "string",
                            "description": "Issuer"
                          },
                          "exp": {
                            "type": "integer",
                            "description": "Expiration timestamp"
                          },
                          "iat": {
                            "type": "integer",
                            "description": "Issued at timestamp"
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "401": {
              "description": "Authentication required or token invalid",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "error": {
                        "type": "string"
                      },
                      "requestId": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/api/login": {
        "post": {
          "summary": "User login",
          "description": "Authenticate using RODiT credentials",
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "roditid",
                    "roditid_base64url_signature"
                  ],
                  "properties": {
                    "roditid": {
                      "type": "string",
                      "description": "RODiT ID"
                    },
                    "timestamp": {
                      "type": "integer",
                      "description": "Current timestamp (optional)"
                    },
                    "roditid_base64url_signature": {
                      "type": "string",
                      "description": "Base64URL signature"
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Login successful"
            },
            "401": {
              "description": "Authentication failed"
            }
          }
        }
      },
