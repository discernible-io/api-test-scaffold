                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "message": { "type": "string" },
                      "usage": { "type": "string" },
                      "requestId": { "type": "string", "format": "ulid" }
                    }
                  }
                }
              }
            }
          }
        }
      },
