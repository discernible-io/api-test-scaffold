      "/api/signclient": {
        "post": {
          "summary": "Sign client RODiT token",
          "description": "Creates and signs a new client RODiT token with specified permissions",
          "tags": ["Authentication"],
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["tobesignedValues", "mintingfee", "mintingfeeaccount"],
                  "properties": {
                    "tobesignedValues": {
                      "type": "object",
                      "description": "Values to be signed in the token"
                    },
                    "mintingfee": {
                      "type": "string",
                      "description": "Fee for minting the token"
                    },
                    "mintingfeeaccount": {
                      "type": "string",
                      "description": "Account to receive the minting fee"
                    }
                  }
                }
              }
            }
          },
          "responses": {
            "201": {
              "description": "Token created successfully"
            },
            "400": {
              "description": "Invalid request"
            },
            "500": {
              "description": "Server error"
            }
          }
        }
      },
      "/api/echo": {
        "post": {
          "summary": "Echo service",
          "description": "Echoes back the provided message exactly as received. Only application/json is accepted. Input may be provided in one of: message, echo, data, or text.",
          "tags": ["Utilities"],
          "security": [
            {
              "bearerAuth": []
            }
          ],
          "requestBody": {
            "required": true,
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "description": "Message to echo back" },
                    "echo": { "type": "string", "description": "Echo string (alternative input field)" },
                    "data": { "type": "string", "description": "Data string (alternative input field)" },
                    "text": { "type": "string", "description": "Text string (alternative input field)" }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "responses": {
            "200": {
              "description": "Message echoed successfully",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "properties": {
                      "data": {
                        "type": "object",
                        "properties": {
                          "message": { "type": "string" },
                          "input": { "type": "string" },
                          "echo": { "type": "string" }
                        }
                      },
                      "requestId": { "type": "string", "format": "ulid" }
                    }
                  }
                }
              }
            },
            "400": {
              "description": "Invalid input"
            },
            "401": {
              "description": "Authentication required"
            }
          }
        },
        "get": {
          "summary": "Echo endpoint info",
          "description": "Returns endpoint usage information. Protected endpoint.",
          "tags": ["Utilities"],
          "security": [ { "bearerAuth": [] } ],
          "responses": {
            "200": {
              "description": "Endpoint usage information",
